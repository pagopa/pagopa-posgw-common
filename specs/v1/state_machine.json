import { createMachine } from "xstate";

createMachine(
  {
    id: "POS Gateway",
    initial: "EMPTY",
    states: {
      EMPTY: {
        on: {
          SESSION_INITIALIZED_EVENT: {
            target: "INITIALIZED",
          },
        },
      },
      INITIALIZED: {
        on: {
          DEBT_POSITION_CREATED_EVENT: {
            target: "DEBT_POSITION_CREATED",
            cond: "debt_position_to_create",
          },
          TRANSACTION_ACTIVATED_EVENT: {
            target: "TRANSACTION_ACTIVATED",
            cond: "not_debt_position_to_create",
          },
          EXPIRED_EVENT: {
            target: "EXPIRED",
          },
          ERROR_EVENT: {
            target: "ERROR",
          },
        },
      },
      DEBT_POSITION_CREATED: {
        on: {
          TRANSACTION_ACTIVATED_EVENT: {
            target: "TRANSACTION_ACTIVATED",
          },
          EXPIRED_EVENT: {
            target: "EXPIRED",
          },
          ERROR_EVENT: {
            target: "ERROR",
          },
        },
      },
      TRANSACTION_ACTIVATED: {
        on: {
          AUTHORIZATION_REQUESTED_EVENT: {
            target: "AUTHORIZATION_REQUESTED",
          },
          AUTHORIZATION_REQUESTED_ERROR_EVENT: {
            cond: "is_retryable",
            target: "AUTHORIZATION_REQUESTED_ERROR",
          },
          EXPIRED_EVENT: {
            target: "EXPIRED",
          },
          ERROR_EVENT: {
            cond: "not_retryable",
            target: "ERROR",
          },
        },
      },
      AUTHORIZATION_REQUESTED: {
        on: {
          AUTHORIZATION_OUTCOME_RECEIVED_EVENT: {
            target: "AUTHORIZATION_COMPLETED",
          },
          EXPIRED_EVENT: {
            target: "EXPIRED_WITH_AUTH_REQUESTED",
          },
        },
      },
      AUTHORIZATION_REQUESTED_ERROR: {
        on: {
          AUTHORIZATION_REQUESTED_EVENT: {
            target: "AUTHORIZATION_REQUESTED",
          },
          AUTHORIZATION_REQUESTED_ERROR_EVENT: {
            cond: "is_retryable",
            target: "AUTHORIZATION_REQUESTED_ERROR",
          },
          EXPIRED_EVENT: {
            target: "EXPIRED",
          },
          ERROR_EVENT: {
            cond: "not_retryable",
            target: "ERROR",
          },
        },
      },
      AUTHORIZATION_COMPLETED: {
        on: {
          CI_NOTIFIED_EVENT: {
            target: "CI_NOTIFIED",
          },
          CI_NOTIFY_ERROR_EVENT: {
            target: "CI_NOTIFY_ERROR",
          },
        },
      },
      CI_NOTIFY_ERROR: {
        on: {
          CI_NOTIFY_ERROR_EVENT: {
            cond: "is_retryable",
            target: "CI_NOTIFY_ERROR",
          },
          CI_NOTIFIED_EVENT: {
            target: "CI_NOTIFIED",
          },
          CI_NOTIFY_EXPIRED_EVENT: {
            target: "CI_NOTIFY_EXPIRED",
          },
        },
      },
      CI_NOTIFY_EXPIRED: {
        on: {
          CI_NOTIFIED_EVENT: {
            target: "CI_NOTIFIED",
          },
          CI_NOTIFY_ERROR_EVENT: {
            target: "CI_NOTIFY_EXPIRED",
          },
          EXPIRED_EVENT: {
            target: "EXPIRED_WITH_AUTH_REQUESTED",
          },
        },
      },
      CI_NOTIFIED: {
        on: {
          ECOMMERCE_NOTIFIED_EVENT: {
            target: "ECOMMERCE_NOTIFIED",
          },
          ECOMMERCE_NOTIFY_ERROR_EVENT: {
            target: "ECOMMERCE_NOTIFY_ERROR",
          },
        },
      },
      RECONCILIATED: {
        type: "final",
      },
      ECOMMERCE_NOTIFY_ERROR: {
        on: {
          ECOMMERCE_NOTIFY_ERROR_EVENT: {
            target: "ECOMMERCE_NOTIFY_ERROR",
          },
          ECOMMERCE_NOTIFIED_EVENT: {
            target: "ECOMMERCE_NOTIFIED",
          },
          ECOMMERCE_NOTIFY_EXPIRED_EVENT: {
            target: "ECOMMERCE_NOTIFY_EXPIRED",
          },
        },
      },
      ECOMMERCE_NOTIFY_EXPIRED: {
        on: {
          ECOMMERCE_NOTIFIED_EVENT: {
            target: "ECOMMERCE_NOTIFIED",
          },
          ECOMMERCE_NOTIFY_ERROR_EVENT: {
            target: "ECOMMERCE_NOTIFY_EXPIRED",
          },
        },
      },
      ECOMMERCE_NOTIFIED: {
        type: "final",
      },
      ERROR: {
        type: "final",
      },
      EXPIRED_WITH_AUTH_REQUESTED: {
        on: {
          RECONCILIATED_EVENT: {
            target: "RECONCILIATED",
          },
        },
      },
      EXPIRED: {
        type: "final",
      },
    },
    context: {
      at_least_one_debt_position_to_create: false,
      authorization_outcome: "OK",
      is_retryable: true,
    },
  },
  {
    guards: {
      debt_position_to_create: (context, event) =>
        context.at_least_one_debt_position_to_create == true,
      not_debt_position_to_create: (context, event) => !debt_position_to_create,
      is_retryable: (context, event) => context.is_retryable == true,
      not_retryable: (context, event) => !is_retryable,
    },
  },
);
